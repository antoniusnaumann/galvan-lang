use serde_json::Error
use serde_json::Value

fn parse_label() -> String!Error {
    serde_json::from_str("\"scores\"")
}

fn serialize_value(value: Value) -> String!Error {
    serde_json::to_string(value)
}

fn main() {
    let label = parse_label() else |error| { "scores" }
    let scores = [32, 48, 64]
    let payload = serde_json::to_string(scores) else |error| { "encoding failed" }
    println "\(label) as json: \(payload)"
}
