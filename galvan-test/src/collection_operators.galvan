test "Collection removal preserves order and duplicate counts" {
    assert([1, 2, 3, 1] -- [1, 2, 4] == [3, 1])
}

test "Array repetition" {
    assert([1] ** 5 == [1, 1, 1, 1, 1])
}

test "String and character repetition" {
    assert "a" ** 5 == "aaaaa"
    assert 'a' ** 5 == "aaaaa"
}

test "All range operators slice arrays" {
    let values = [0, 1, 2, 3, 4]
    assert values[1..<4] == [1, 2, 3]
    assert values[1..=3] == [1, 2, 3]
    assert values[1..+2] == [1, 2, 3]
    assert values[2+-1] == [1, 2, 3]
    assert values[3..-2] == [3, 2, 1]
}

test "All range operators slice strings by character" {
    let text = "aé😊z"
    assert text[1..<3] == "é😊"
    assert text[1..=2] == "é😊"
    assert text[1..+1] == "é😊"
    assert text[2+-1] == "é😊z"
    assert text[3..-2] == "z😊é"
}

test "Collection operators read through references" {
    ref values = [1, 2, 1]
    assert values -- [1] == [2, 1]
    assert values ** 2 == [1, 2, 1, 1, 2, 1]
    assert values[0..=1] == [1, 2]
}
